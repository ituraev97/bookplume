{{ 'bookplume-2026.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign step_count = section.blocks.size
-%}

<section class="bp2 bp2-story" data-story data-story-count="{{ step_count }}" style="--bp-steps:{{ step_count }}">
  <div class="bp2-story-sticky">
    <div class="bp2-wrap bp2-story-wrap">
      <div class="bp2-story-copy">
        {%- for block in section.blocks -%}
          <h2 class="bp2-story-line{% if forloop.first %} is-active{% endif %}" data-story-text data-story-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {{- block.settings.line -}}
          </h2>
        {%- endfor -%}
      </div>
      <div class="bp2-story-media">
        {%- for block in section.blocks -%}
          {%- liquid
            assign story_product = block.settings.collection.products.first
            assign loading_strategy = 'lazy'
            if forloop.first
              assign loading_strategy = 'eager'
            endif
          -%}
          <div class="bp2-story-media-item{% if forloop.first %} is-active{% endif %}" data-story-media>
            {%- if story_product.featured_image -%}
              {{
                story_product.featured_image
                | image_url: width: 900
                | image_tag: loading: loading_strategy,
                  widths: '450,650,900',
                  alt: story_product.featured_image.alt | default: story_product.title
              }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Book Plume — Story 2026",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "step",
      "name": "Story step",
      "settings": [
        {
          "type": "text",
          "id": "line",
          "label": "Line",
          "default": "Learn something new."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection to pull the cover image from"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Book Plume — Story 2026",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
