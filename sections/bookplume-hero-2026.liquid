{{ 'bookplume-2026.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_collection = section.settings.collection
  if hero_collection == blank or hero_collection.products.size == 0
    assign hero_collection = collections['bestsellers']
  endif
  if hero_collection == blank or hero_collection.products.size == 0
    assign hero_collection = collections['all']
  endif
-%}

<section class="bp2 bp2-hero">
  <div class="bp2-wrap bp2-hero-copy">
    <h1 class="bp2-hero-title" data-reveal>{{ section.settings.heading }}</h1>
    <p class="bp2-hero-sub" data-reveal style="--bp-reveal-delay:90ms">{{ section.settings.subheading }}</p>
    <div class="bp2-hero-ctas" data-reveal style="--bp-reveal-delay:180ms">
      {%- if section.settings.primary_link != blank -%}
        <a class="bp2-btn bp2-btn--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_text }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_link != blank -%}
        <a class="bp2-btn bp2-btn--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_text }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- if hero_collection != blank -%}
    <div class="bp2-hero-stage">
      {%- for product in hero_collection.products limit: 5 -%}
        {%- liquid
          assign loading_strategy = 'lazy'
          if forloop.index0 == 0 or forloop.index0 == 2
            assign loading_strategy = 'eager'
          endif
        -%}
        <a
          class="bp2-hero-item bp2-hero-item--{{ forloop.index }}"
          href="{{ product.url }}"
          aria-label="{{ product.title | escape }}"
          data-reveal
          style="--bp-reveal-delay:{{ forloop.index0 | times: 90 | plus: 220 }}ms"
          data-parallax-speed="{{ forloop.index0 | modulo: 3 | minus: 1 | times: 0.03 }}"
        >
          {%- if product.featured_image -%}
            {{
              product.featured_image
              | image_url: width: 500
              | image_tag: loading: loading_strategy,
                widths: '250,350,500',
                alt: product.featured_image.alt | default: product.title
            }}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Book Plume — Hero 2026",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Books worth keeping."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover books that teach, inspire, entertain and make great gifts."
    },
    {
      "type": "text",
      "id": "primary_text",
      "label": "Primary button label",
      "default": "Explore books"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary button label",
      "default": "Shop bestsellers"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to pull cover images from",
      "info": "Falls back to Bestsellers, then All products."
    }
  ],
  "presets": [
    {
      "name": "Book Plume — Hero 2026"
    }
  ]
}
{% endschema %}
