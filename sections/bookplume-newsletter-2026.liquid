{{ 'bookplume-2026.css' | asset_url | stylesheet_tag }}

<section class="bp2 bp2-news">
  <div class="bp2-wrap bp2-news-grid">
    <div data-reveal>
      <div class="bp2-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div data-reveal style="--bp-reveal-delay:90ms">
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Your email address" required>
        <button type="submit">{{ section.settings.button_text }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Book Plume — Newsletter 2026",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Book Plume newsletter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New finds, restocks & worthwhile deals."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "No inbox clutter. Just books worth knowing about."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Join the list"
    }
  ],
  "presets": [
    {
      "name": "Book Plume — Newsletter 2026"
    }
  ]
}
{% endschema %}
