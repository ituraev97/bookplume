{{ 'bookplume-2026.css' | asset_url | stylesheet_tag }}

<div class="bp2 bp2-benefits">
  <div class="bp2-wrap bp2-benefits-grid">
    {%- for block in section.blocks -%}
      <div class="bp2-benefit" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Book Plume — Benefits 2026",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders $35+"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Book Plume — Benefits 2026",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Free U.S. shipping on $35+" } },
        { "type": "benefit", "settings": { "text": "Fast dispatch · 1–2 business days" } },
        { "type": "benefit", "settings": { "text": "Secure checkout & easy returns" } }
      ]
    }
  ]
}
{% endschema %}
