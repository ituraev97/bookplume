<style>
  :root{--bp-ink:#292722;--bp-paper:#f8f6f1;--bp-card:#fffefa;--bp-terra:#ad5135;--bp-sage:#687568;--bp-line:#ded8ce;--bp-dark:#292b27}
  body{background:var(--bp-paper)!important;color:var(--bp-ink);font-family:var(--font-body-family);letter-spacing:.005em}
  .header-wrapper{background:rgba(248,246,241,.97)!important;border-bottom:1px solid var(--bp-line)!important;backdrop-filter:blur(14px)}.header{max-width:142rem!important;padding-top:13px!important;padding-bottom:13px!important}.header__heading-link .h2{font-size:0!important}.header__heading-link .h2:after{content:'Book Plume';font-size:29px;line-height:1;font-family:var(--font-heading-family);font-weight:400;letter-spacing:-.035em;color:var(--bp-ink)}.header__menu-item{font-size:13px;letter-spacing:.015em}.header__menu-item:hover{color:var(--bp-terra)}.announcement-bar{min-height:34px}.announcement-bar__message{font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}
  .bp-home *{box-sizing:border-box}.bp-wrap{width:min(1420px,calc(100% - 56px));margin:auto}.bp-kicker{font-size:10px;font-weight:800;letter-spacing:.19em;text-transform:uppercase}.bp-home h1,.bp-home h2,.bp-home h3{color:var(--bp-ink);margin:0;font-family:var(--font-heading-family);font-weight:400}.bp-home h1{font-size:clamp(46px,5.2vw,76px);line-height:.98;letter-spacing:-.045em;max-width:720px}.bp-home h2{font-size:clamp(29px,2.6vw,42px);line-height:1.08;letter-spacing:-.035em}.bp-home p{line-height:1.65}.bp-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 23px;border-radius:999px;text-decoration:none;font-weight:700;font-size:13px;transition:.2s}.bp-btn--terra{background:var(--bp-terra);color:#fff}.bp-btn--terra:hover{transform:translateY(-2px);background:#91422c}.bp-btn--light{background:#fff;color:var(--bp-ink);border:1px solid var(--bp-line)}
  .bp-searchbar{padding:16px 0;border-bottom:1px solid var(--bp-line);background:#fffdfa}.bp-search{display:flex;gap:10px;max-width:980px;margin:auto}.bp-search input{flex:1;height:52px;border:1px solid #d1c9bd;border-radius:999px;padding:0 23px;font:inherit;font-size:14px;background:#fff}.bp-search button{border:0;border-radius:999px;padding:0 27px;background:var(--bp-ink);color:#fff;font-weight:700;cursor:pointer}
  .bp-hero{padding:66px 0 60px;background:linear-gradient(135deg,#eee8de 0%,#faf8f4 58%,#e8dfd2 100%);overflow:hidden}.bp-hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:58px;align-items:center}.bp-hero-copy{max-width:720px}.bp-hero .bp-kicker{color:var(--bp-terra);margin-bottom:18px}.bp-hero p{font-size:16px;max-width:620px;color:#666057;margin:22px 0 28px}.bp-actions{display:flex;gap:11px;flex-wrap:wrap}.bp-hero-art{min-height:390px;position:relative;display:grid;place-items:center}.bp-orb{width:370px;height:370px;border-radius:50%;background:var(--bp-terra);opacity:.92}.bp-book{position:absolute;width:155px;aspect-ratio:2/3;border-radius:7px;box-shadow:0 24px 50px rgba(37,35,31,.18);display:flex;align-items:flex-end;padding:18px;color:white;font-family:var(--font-heading-family);font-size:22px;line-height:1.05}.bp-book.one{background:#25352e;transform:translate(-105px,10px) rotate(-8deg)}.bp-book.two{background:#d9aa50;transform:translate(12px,-30px) rotate(4deg);color:#2b261d}.bp-book.three{background:#6d526b;transform:translate(125px,30px) rotate(10deg)}
  .bp-benefits{background:var(--bp-dark);color:#fff}.bp-benefit-grid{display:grid;grid-template-columns:repeat(3,1fr)}.bp-benefit{padding:17px 26px;text-align:center;border-right:1px solid rgba(255,255,255,.13);font-size:11px;letter-spacing:.06em;font-weight:700}.bp-benefit:last-child{border:0}
  .bp-section{padding:62px 0}.bp-section--soft{background:#f0ece4}.bp-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:28px}.bp-head p{margin:7px 0 0;color:#756f66;font-size:14px}.bp-link{color:var(--bp-terra);font-weight:700;font-size:13px;text-decoration:none;white-space:nowrap}.bp-cats{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.bp-cat{min-height:145px;padding:20px;border:1px solid var(--bp-line);border-radius:15px;background:var(--bp-card);text-decoration:none;color:var(--bp-ink);display:flex;flex-direction:column;justify-content:space-between;transition:.2s}.bp-cat:hover{transform:translateY(-3px);border-color:#b7ab9b;box-shadow:0 12px 26px rgba(37,35,31,.06)}.bp-cat span:first-child{font-size:23px}.bp-cat strong{font-family:var(--font-heading-family);font-weight:400;font-size:19px;letter-spacing:-.02em}.bp-cat small{color:#817a70;font-size:12px}
  .bp-products{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:26px 18px}.bp-product{min-width:0}.bp-cover{background:#ebe7df;border-radius:10px;overflow:hidden;aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;position:relative}.bp-cover img{width:100%;height:100%;object-fit:contain;padding:16px;transition:.25s}.bp-product:hover .bp-cover img{transform:scale(1.025)}.bp-badge{position:absolute;left:8px;top:8px;background:var(--bp-terra);color:#fff;border-radius:999px;padding:5px 8px;font-size:9px;letter-spacing:.04em;font-weight:800}.bp-product h3{font-family:var(--font-body-family);font-size:13px;line-height:1.4;margin:11px 2px 5px;font-weight:650;letter-spacing:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.bp-product a{text-decoration:none;color:inherit}.bp-price{margin-left:2px;font-weight:700;font-size:13px}.bp-compare{text-decoration:line-through;color:#969087;font-weight:400;margin-left:5px;font-size:11px}
  .bp-banner{margin:8px auto 0;width:min(1420px,calc(100% - 56px));border-radius:20px;background:var(--bp-terra);color:#fff;padding:50px;display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:30px}.bp-banner h2{color:#fff;max-width:700px}.bp-banner p{max-width:620px;color:#f8e9e3;font-size:14px}.bp-banner-side{font-family:var(--font-heading-family);font-size:clamp(48px,6vw,88px);line-height:.8;text-align:right;opacity:.18}.bp-news{padding:58px 0;background:#dfe4dc}.bp-news-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}.bp-news form{display:flex;gap:10px}.bp-news input{height:52px;flex:1;border:1px solid #aab3a7;border-radius:999px;padding:0 22px;background:#fff}.bp-news button{border:0;border-radius:999px;background:var(--bp-ink);color:#fff;padding:0 25px;font-weight:700}.footer{border-top:0!important}.footer__content-top{max-width:142rem!important}
  @media(max-width:1100px){.bp-cats{grid-template-columns:repeat(3,1fr)}.bp-products{grid-template-columns:repeat(4,1fr)}.bp-product:nth-child(n+9){display:none}}
  @media(max-width:749px){.bp-wrap,.bp-banner{width:min(100% - 28px,1420px)}.header__heading-link .h2:after{font-size:23px}.bp-searchbar{padding:11px 0}.bp-search input{height:48px}.bp-search button{padding:0 17px}.bp-hero{padding:44px 0}.bp-hero-grid{grid-template-columns:1fr;gap:18px}.bp-hero-art{min-height:275px}.bp-orb{width:245px;height:245px}.bp-book{width:104px;font-size:15px;padding:12px}.bp-book.one{transform:translate(-70px,10px) rotate(-8deg)}.bp-book.two{transform:translate(7px,-22px) rotate(4deg)}.bp-book.three{transform:translate(80px,22px) rotate(10deg)}.bp-benefit-grid{grid-template-columns:1fr}.bp-benefit{border-right:0;border-bottom:1px solid rgba(255,255,255,.12);padding:12px}.bp-section{padding:45px 0}.bp-head{align-items:start}.bp-cats{grid-template-columns:repeat(2,1fr)}.bp-cat{min-height:132px}.bp-products{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:12px;gap:13px}.bp-product{flex:0 0 39%;scroll-snap-align:start}.bp-product:nth-child(n){display:block}.bp-cover img{padding:10px}.bp-banner{padding:32px 25px;grid-template-columns:1fr}.bp-banner-side{text-align:left}.bp-news-grid{grid-template-columns:1fr}.bp-news form{flex-direction:column}.bp-news button{height:50px}}
</style>
<div class="bp-home"><div class="bp-searchbar"><div class="bp-wrap"><form class="bp-search" action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" placeholder="Search by title, author, ISBN or topic" aria-label="Search Book Plume"><input type="hidden" name="type" value="product"><button type="submit">Search</button></form></div></div><section class="bp-hero"><div class="bp-wrap bp-hero-grid"><div class="bp-hero-copy"><div class="bp-kicker">Book Plume · Books worth keeping</div><h1>Find the book you didn't know you needed.</h1><p>Smart, useful and giftable books — from anatomy and medical learning to coloring, faith, trivia and bestselling reads.</p><div class="bp-actions"><a class="bp-btn bp-btn--terra" href="/collections/bestsellers">Shop bestsellers</a><a class="bp-btn bp-btn--light" href="/collections/all">Browse all books</a></div></div><div class="bp-hero-art" aria-hidden="true"><div class="bp-orb"></div><div class="bp-book one">Learn something new.</div><div class="bp-book two">Books worth keeping.</div><div class="bp-book three">Give a better gift.</div></div></div></section><div class="bp-benefits"><div class="bp-wrap bp-benefit-grid"><div class="bp-benefit">FREE U.S. SHIPPING ON $35+</div><div class="bp-benefit">FAST DISPATCH · 1–2 BUSINESS DAYS</div><div class="bp-benefit">SECURE CHECKOUT & EASY RETURNS</div></div></div><section class="bp-section"><div class="bp-wrap"><div class="bp-head"><div><div class="bp-kicker">Browse by interest</div><h2>Find your shelf</h2></div><a class="bp-link" href="/collections/all">Shop all →</a></div><div class="bp-cats"><a class="bp-cat" href="/collections/anatomy-education"><span>🫀</span><strong>Anatomy & Medical</strong><small>Study smarter</small></a><a class="bp-cat" href="/collections/stress-relief-coloring"><span>✏️</span><strong>Coloring & Journals</strong><small>Slow down & create</small></a><a class="bp-cat" href="/collections/bible-christian-trivia"><span>✦</span><strong>Bible & Faith</strong><small>Read & reflect</small></a><a class="bp-cat" href="/collections/trivia-fun-facts"><span>?</span><strong>Trivia & Fun Facts</strong><small>Learn for fun</small></a><a class="bp-cat" href="/collections/libros-en-espanol"><span>Ñ</span><strong>Libros en Español</strong><small>Lee más</small></a><a class="bp-cat" href="/collections/all"><span>↗</span><strong>All Books</strong><small>Explore everything</small></a></div></div></section>{% assign featured = collections['bestsellers'] %}{% if featured == blank or featured.products.size == 0 %}{% assign featured = collections['all'] %}{% endif %}<section class="bp-section bp-section--soft"><div class="bp-wrap"><div class="bp-head"><div><div class="bp-kicker">Trending now</div><h2>Books readers are choosing</h2><p>Popular picks from across Book Plume.</p></div><a class="bp-link" href="{{ featured.url }}">Shop all →</a></div><div class="bp-products">{% for product in featured.products limit: 12 %}{% render 'bookplume-product', product: product %}{% endfor %}</div></div></section><section class="bp-banner"><div><div class="bp-kicker">The Book Plume edit</div><h2>Less endless scrolling. More books you actually want.</h2><p>We focus on useful, interesting and giftable titles — a tighter bookstore built around discovery instead of clutter.</p><a class="bp-btn bp-btn--light" href="/collections/all">Explore the collection</a></div><div class="bp-banner-side">READ<br>MORE</div></section>{% assign anatomy = collections['anatomy-education'] %}{% if anatomy != blank and anatomy.products.size > 0 %}<section class="bp-section"><div class="bp-wrap"><div class="bp-head"><div><div class="bp-kicker">Learn visually</div><h2>Anatomy & medical favorites</h2><p>Coloring books, flash cards and visual learning tools.</p></div><a class="bp-link" href="{{ anatomy.url }}">View collection →</a></div><div class="bp-products">{% for product in anatomy.products limit: 12 %}{% render 'bookplume-product', product: product %}{% endfor %}</div></div></section>{% endif %}{% assign coloring = collections['stress-relief-coloring'] %}{% if coloring != blank and coloring.products.size > 0 %}<section class="bp-section bp-section--soft"><div class="bp-wrap"><div class="bp-head"><div><div class="bp-kicker">Unplug for a while</div><h2>Coloring, journals & slow moments</h2></div><a class="bp-link" href="{{ coloring.url }}">View collection →</a></div><div class="bp-products">{% for product in coloring.products limit: 12 %}{% render 'bookplume-product', product: product %}{% endfor %}</div></div></section>{% endif %}{% assign faith = collections['bible-christian-trivia'] %}{% if faith != blank and faith.products.size > 0 %}<section class="bp-section"><div class="bp-wrap"><div class="bp-head"><div><div class="bp-kicker">Read & reflect</div><h2>Bible & faith</h2></div><a class="bp-link" href="{{ faith.url }}">View collection →</a></div><div class="bp-products">{% for product in faith.products limit: 12 %}{% render 'bookplume-product', product: product %}{% endfor %}</div></div></section>{% endif %}<section class="bp-news"><div class="bp-wrap bp-news-grid"><div><div class="bp-kicker">Book Plume newsletter</div><h2>New finds, restocks & worthwhile deals.</h2><p>No inbox clutter. Just books worth knowing about.</p></div>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="Your email address" required><button type="submit">Join the list</button>{% endform %}</div></section></div>
