{%- comment -%}
  Renders breadcrumb navigation and matching BreadcrumbList structured data.
  Covers the indexable, hierarchical page types: product, collection, article, page.
  Skipped on the home page, where a breadcrumb trail is meaningless.

  Accepts: none (reads request.page_type and the current template's global object)
  Usage: {% render 'breadcrumbs' %}
{%- endcomment -%}

{%- liquid
  assign home_title = 'general.breadcrumbs.home' | t
  assign home_url = routes.root_url

  assign mid_title = blank
  assign mid_url = blank
  assign current_title = blank

  case request.page_type
    when 'product'
      assign product_collection = collection
      if product_collection == blank
        assign product_collection = product.collections.first
      endif
      if product_collection != blank
        assign mid_title = product_collection.title
        assign mid_url = product_collection.url
      endif
      assign current_title = product.title
    when 'collection'
      assign current_title = collection.title
    when 'article'
      assign mid_title = blog.title
      assign mid_url = blog.url
      assign current_title = article.title
    when 'blog'
      assign current_title = blog.title
    when 'page'
      assign current_title = page.title
  endcase
-%}

{%- if current_title != blank -%}
  <nav class="breadcrumbs page-width" aria-label="{{ 'general.breadcrumbs.label' | t }}" style="padding-top: 1.5rem;">
    <ol
      class="breadcrumbs__list caption list-unstyled"
      role="list"
      style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5em; margin: 0;"
    >
      <li class="breadcrumbs__item">
        <a href="{{ home_url }}" class="link">{{ home_title }}</a>
      </li>
      {%- if mid_title != blank -%}
        <li class="breadcrumbs__item" aria-hidden="true" style="opacity: 0.6;">/</li>
        <li class="breadcrumbs__item">
          <a href="{{ mid_url }}" class="link">{{ mid_title }}</a>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item" aria-hidden="true" style="opacity: 0.6;">/</li>
      <li class="breadcrumbs__item" aria-current="page">{{ current_title }}</li>
    </ol>
  </nav>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ home_title | json }},
          "item": {{ home_url | prepend: request.origin | json }}
        },
        {%- if mid_title != blank -%}
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ mid_title | json }},
            "item": {{ mid_url | prepend: request.origin | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ current_title | json }},
            "item": {{ canonical_url | json }}
          }
        {%- else -%}
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ current_title | json }},
            "item": {{ canonical_url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
