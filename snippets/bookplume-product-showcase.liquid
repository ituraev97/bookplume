{% comment %}
  Renders a chrome-less, whitespace-first product presentation for the
  2026 Book Plume storefront sections.

  Accepts:
  - product: {Product}
  - reveal: {Boolean} add a data-reveal entrance animation hook
{% endcomment %}

<a class="bp2-product" href="{{ product.url }}"{% if reveal %} data-reveal{% endif %}>
  <div class="bp2-product-cover">
    {%- if product.featured_image -%}
      {{
        product.featured_image
        | image_url: width: 700
        | image_tag: loading: 'lazy', widths: '350,500,700', alt: product.featured_image.alt | default: product.title
      }}
    {%- endif -%}
  </div>
  <div class="bp2-product-info">
    <div class="bp2-product-title">{{ product.title }}</div>
    <div class="bp2-product-meta">
      <span class="bp2-product-price">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="bp2-product-compare">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
  </div>
</a>
